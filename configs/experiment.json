{
  "schema_version": 4,
  "stage": "experiment_design",
  "strategies": [
    "static",
    "semantic"
  ],
  "scenarios": [
    "stable",
    "shift"
  ],
  "repetitions": 10,
  "seed": 4210,
  "warmup": 5,
  "history_size": 10,
  "initial_history_events": 10,
  "measured_tasks": 24,
  "shift_after_task": 12,
  "focused_probability": 0.8,
  "bootstrap": 5000,
  "practical_viewports": 0.5,
  "aa_pairs": 5,
  "components": [
    "layout",
    "specifications",
    "purchase_options",
    "mortgage",
    "complex_features",
    "apartment_features",
    "similar_apartments"
  ],
  "component_descriptions": {
    "layout": "Планировка квартиры и её расположение на этаже.",
    "specifications": "Характеристики квартиры: площадь, этаж, адрес, вид из окна и срок сдачи.",
    "purchase_options": "Способы покупки: полная оплата, ипотека, трейд-ин и доступные скидки.",
    "mortgage": "Ипотечный калькулятор: первоначальный взнос, срок кредита, ежемесячный платёж и предложения банков.",
    "complex_features": "Преимущества жилого комплекса: двор, парк, детские сады, парковка и общие пространства.",
    "apartment_features": "Преимущества квартиры: балкон, отделка и высота потолков.",
    "similar_apartments": "Похожие квартиры: планировки, площадь, этаж, стоимость и ежемесячный платёж."
  },
  "embedding": {
    "model": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
    "revision": "e8f8c211226b894fcb81acc59f3b34ba3efd5f42",
    "device": "cpu",
    "normalize": true,
    "max_seq_length": 128,
    "runtime": "transformers.js",
    "library_version": "3.8.1",
    "format": "onnx",
    "file": "onnx/model.onnx",
    "dtype": "fp32",
    "pooling": "mean"
  },
  "viewport": {
    "width": 1280,
    "height": 900
  },
  "threads": 1,
  "required_components_per_task": 2,
  "comparisons": [
    {
      "reference": "static",
      "candidate": "semantic"
    }
  ],
  "primary_metric": "scroll_distance_viewports",
  "scroll_measurement": {
    "task_start": "top",
    "target_order": "from_task_plan",
    "alignment": "block_top_clamped_to_page",
    "distance": "sum_absolute_actual_scroll_offsets",
    "unit": "viewport_height"
  },
  "client_observation": {
    "event": "block_view",
    "focus": "viewport_center_inside_block",
    "minimum_ms": 1000
  },
  "runtime": {
    "target": {
      "kind": "fixed_copy_of_rendered_page",
      "image": "nginx:1.28.0-alpine",
      "cpus": 0.5,
      "memory_mib": 128,
      "digest": "sha256:30f1c0d78e0ad60901648be663a710bdadf19e4c10ac6782c235200619158284"
    },
    "api": {
      "node": "24.11.0",
      "image": "node:24.11.0-bookworm-slim",
      "digest": "sha256:76d0ed0ed93bed4f4376211e9d8fddac4d8b3fbdb54cc45955696001a3c91152",
      "server": "node:http",
      "transformers_js": "3.8.1",
      "cpus": 1,
      "memory_mib": 2048
    },
    "runner": {
      "python": "3.12.3",
      "image": "mcr.microsoft.com/playwright/python:v1.56.0-noble",
      "digest": "sha256:a7f6cf3ae520c9d670ad956572c13747ed5abdbba5123a01526f873ed1662528",
      "playwright": "1.56.0",
      "numpy": "2.2.6",
      "scipy": "1.15.3",
      "matplotlib": "3.10.3",
      "cpus": 1,
      "memory_mib": 1024,
      "shm_mib": 512
    }
  },
  "integration": {
    "type": "external_script",
    "client": "adapt.js",
    "backend": "node_api",
    "site_adapter_required": true,
    "block_ids": [
      "layout",
      "specifications",
      "purchase_options",
      "mortgage",
      "complex_features",
      "apartment_features",
      "similar_apartments"
    ],
    "baseline": "original_block_order",
    "apply_changes": "before_task",
    "on_api_error": "keep_current_layout",
    "preserve_dom_nodes": true,
    "session_scope": "run",
    "reset_before_run": true,
    "allowed_changes": [
      "order"
    ],
    "preserve_expansion_state": true
  },
  "task_validation": {
    "expected_values": "fixed_page_fixture",
    "success": "both_target_actions_and_expected_answers_match"
  },
  "background_targets": "uniform_pair_without_replacement_from_other_five"
}
